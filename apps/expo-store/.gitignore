# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects, generated by `expo prebuild` from app.json.
#
# Ignored because they are output, not source: app.json plus the plugin list is
# the description, and these directories are what that description compiles to.
# Committing them means the next `prebuild` produces a diff nobody wrote, and an
# edit made here is silently discarded by the following one.
/android
/ios

# Native build output
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
