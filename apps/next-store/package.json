{
  "name": "@honeystick/next-store",
  "version": "0.80.1",
  "private": true,
  "description": "Honeystick Example App - a sample ecommerce store built on Honeystick and Next.js",
  "scripts": {
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy --env production",
    "cf:deploy:dev": "opennextjs-cloudflare deploy --env dev",
    "cf:preview": "opennextjs-cloudflare preview --env production",
    "cf:preview:dev": "opennextjs-cloudflare preview --env dev",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev": "next dev",
    "lint": "eslint",
    "start": "next start",
    "test": "npx playwright test"
  },
  "dependencies": {
    "@honeystick/next": "*",
    "@honeystick/react": "*",
    "chalk": "^5.6.2",
    "honeystick": "*",
    "immer": "^11.1.8",
    "motion": "^12.38.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remeda": "^2.34.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "wrangler": "^4.120.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.4.0",
    "eslint-config-next": "^16.2.6",
    "typescript": "^6.0.3"
  }
}
