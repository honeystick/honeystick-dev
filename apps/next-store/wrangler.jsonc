{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honeystick-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",

  // nodejs_compat is required by OpenNext - Next's server half is Node code.
  // global_fetch_strictly_public makes a fetch to this Worker's own hostname go
  // out to the internet and come back through the router, rather than being
  // short-circuited inside the isolate. Without it a server component fetching
  // the store's own URL resolves to something that never reaches the route.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Everything in /public plus Next's build output, served by Cloudflare
  // without waking the Worker.
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },

  // The demo's address, as a Worker *route* rather than a custom domain.
  //
  // The difference decides whether a deploy succeeds. `custom_domain: true`
  // makes Cloudflare create and own the DNS record, which collides with a
  // record that already exists - and demo.honeystick.co.za already has a
  // proxied AAAA. A route takes the opposite arrangement: the DNS record is
  // yours, it only has to resolve into Cloudflare's network, and the route is
  // what makes this Worker answer for the hostname.
  //
  // That is why the existing record points at a discard address behind the
  // orange cloud. Nothing is ever fetched from it: a Worker route is handled at
  // the edge and never reaches an origin, so the address only needs to exist so
  // the name resolves and the proxy has something to intercept.
  //
  // The wildcard is not optional. A route pattern matches paths, so a bare
  // hostname matches exactly one URL - the root - and every other path on the
  // site would miss the Worker entirely. `custom_domain` needed no wildcard,
  // which is the easiest thing to carry over from it by mistake.
  //
  // `zone_name` is required for a route and is not needed for a custom domain,
  // so the API token has to carry Zone → Workers Routes → Edit on this zone as
  // well as Account → Workers Scripts → Edit. The "Edit Cloudflare Workers"
  // template includes both.
  "observability": {
    "enabled": true
  },

  /**
   * Leave variables set in the dashboard alone.
   *
   * Without this a deploy treats `vars` below as the complete list and deletes
   * anything on the Worker that is not in it - so a value added through the
   * Cloudflare UI survives until the next push and then quietly disappears,
   * which is the kind of failure you debug for an hour.
   *
   * It is a top-level-only key: wrangler refuses it inside a named environment,
   * so this one entry governs both Workers.
   *
   * Secrets are not affected either way. `wrangler secret put` values are never
   * removed by a deploy - only by `wrangler secret delete` - so
   * HONEYSTICK_SECRET_KEY was never at risk here.
   *
   * The trade worth knowing: with this on, *removing* a var from this file no
   * longer removes it from the Worker. Deleting one for real means doing it in
   * the dashboard as well.
   */
  "keep_vars": true,

  /**
   * Both Workers, named explicitly.
   *
   * Production is an environment rather than the top level, which is the one
   * structural choice here worth defending. With environments defined, a bare
   * `wrangler deploy` is ambiguous - wrangler warns and falls through to the
   * top level - so the shape that cannot be got wrong is: nothing deployable at
   * the top level, and every deploy naming its target. The scripts do
   * (`cf:deploy` is `--env production`).
   *
   * `vars` is repeated in both because it is **not** inheritable: omit it and
   * that Worker deploys with no variables, which looks like a success and then
   * fails at request time on a missing origin.
   *
   * `routes` is repeated for the opposite reason - it *is* inheritable, so a
   * missing one would silently adopt the other environment's hostname.
   *
   * `observability`, `assets` and the compatibility settings are inheritable
   * and deliberately live once, at the top.
   *
   * Secrets are per environment: `wrangler secret put HONEYSTICK_SECRET_KEY
   * --env production` and again with `--env dev`. Pointing the two at different
   * organizations is the whole reason to have two Workers, so that a test
   * checkout on dev never lands in the demo organization's customer list.
   *
   * Each hostname needs its own proxied DNS record: a route only intercepts a
   * name that already resolves into Cloudflare.
   */
  "env": {
    "production": {
      "name": "honeystick-demo",
      "routes": [
        {
          "pattern": "demo.honeystick.co.za/*",
          "zone_name": "honeystick.co.za"
        }
      ],
      "vars": {
        "NEXT_PUBLIC_STORE_URL": "https://demo.honeystick.co.za",

        // Where the Honeystick badge points: the Honeystick **app**, whose
        // production Worker serves honeystick.co.za/* (see the app's own
        // wrangler.jsonc). Not this store's own address - a badge on the demo
        // linking to the demo is a link to the page you are already on - and
        // not HONEYSTICK_URL, which is the API.
        //
        // Read on the server in layout.tsx and passed to the client component
        // as a prop, *not* NEXT_PUBLIC_: one bundle serves both Workers, and a
        // NEXT_PUBLIC_ value is inlined by `next build` so it would be the same
        // on both.
        "HS_APP_URL": "https://honeystick.co.za"

        // No HONEYSTICK_URL and no HONEYSTICK_DEPLOYMENT.
        //
        // That is the point of the two axes rather than an oversight. The
        // secret key says `sandbox`, the deployment defaults to `production`,
        // and the SDK resolves those to sandbox.honeystick.co.za on its own -
        // which is exactly where a public demo should be pointing.
        //
        // Set HONEYSTICK_URL only to reach an API that is not one of the four
        // hosted ones, such as a local server on :8787.
      }
    },

    "dev": {
      "name": "honeystick-demo-dev",
      "routes": [
        {
          "pattern": "dev-demo.honeystick.co.za/*",
          "zone_name": "honeystick.co.za"
        }
      ],
      "vars": {
        "NEXT_PUBLIC_STORE_URL": "https://dev-demo.honeystick.co.za",
        // the app's preview Worker - dev.honeystick.co.za/*
        "HS_APP_URL": "https://dev.honeystick.co.za",

        // The one variable that separates this Worker from the production one,
        // API-wise. With the same sandbox key, `dev` resolves to
        // dev-sandbox.honeystick.co.za instead of sandbox.honeystick.co.za -
        // so an internal test checkout never touches the estate customers use.
        "HONEYSTICK_DEPLOYMENT": "dev"
      }
    }
  }

  // No account_id. It is not a secret, but a public repo advertising which
  // Cloudflare account to aim at is free reconnaissance, and wrangler reads
  // CLOUDFLARE_ACCOUNT_ID from the environment instead.
}
