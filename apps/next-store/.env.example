# Honeystick Example App - environment
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not, so
# never put a real key here.
#
#   cp .env.example .env.local
#
# Everything below is read on the server only. None of it is NEXT_PUBLIC_ except
# where marked, and that distinction is load-bearing: anything a client
# component can import is bundled and served, so a secret with a NEXT_PUBLIC_
# prefix is a published secret.

# Your Honeystick secret key, and the only thing needed to go live. It is a
# token that already carries the claim of which organization it belongs to, so
# there is no org id to set alongside it.
#
# This one variable is the switch between sample data and a live catalogue: with
# it unset the store serves DUMMY_PLANS from lib/catalogue/plans.ts, and both
# checkout and subscribe stop short of the one call that needs an organization,
# so a fresh clone still runs end to end.
HONEYSTICK_SECRET_KEY=

# Which Honeystick estate to call: `production` (default) or `dev`.
#
# The second of two axes, and the one nobody outside Honeystick sets. Four API
# servers run at once - a sandbox and a live on each of the two deployments -
# and between them your key and this variable pick exactly one:
#
#                     sandbox                            live
#   production        sandbox.honeystick.co.za           live.honeystick.co.za
#   dev               dev-sandbox.honeystick.co.za       dev-live.honeystick.co.za
#
# The row comes from here; the column comes from the key, which names its own
# environment (hs_sk_sandbox_... / hs_sk_live_...). Leave this unset and you get
# the production row, which is the only one a customer key works against.
HONEYSTICK_DEPLOYMENT=

# The signing secret for a webhook endpoint you registered.
#
# Distinct from the secret key above, and not interchangeable with it: this one
# is minted per endpoint (`whsec_...`), is shown in Settings → Integrations →
# Webhooks, and is only ever used to verify an HMAC. It is never sent anywhere.
#
# Unset is supported. The webhook route answers 503 rather than accepting posts
# it cannot verify - a route that trusts an unsigned body because it happens to
# have no secret is worse than no route at all.
#
# What arrives here is every event the endpoint subscribed to, signed and
# retried - as opposed to the per-checkout `notify_url` nudge, which carries
# only a settled payment and is neither.
HONEYSTICK_WEBHOOK_SECRET=


# Which Honeystick API to call, named outright.
#
# Only for an API that is not one of the four above - a local server, or a self
# hosted one. It wins over both the key's environment and HONEYSTICK_DEPLOYMENT,
# so setting it means neither is consulted.
#
# An origin only; the SDK appends /api/v1. Use a LAN IP rather than localhost if
# you load the store from another device.
HONEYSTICK_URL=http://localhost:8787

# Where the Honeystick badge in the corner of every page points.
#
# The Honeystick **app**, and worth separating from the two names next to it:
#
#   HS_APP_URL      this - the app a shopper is sent to. honeystick.co.za live,
#                   dev.honeystick.co.za on preview, :8081 when you run it here.
#   HONEYSTICK_URL  the API the SDK calls. Server-side, never a destination.
#
# It is also not this store's own address. A badge on the demo store pointing at
# the demo store is a link to the page you are already looking at.
#
# Deliberately not NEXT_PUBLIC_. It is read on the server in app/layout.tsx and
# handed to the client component as a prop, because a NEXT_PUBLIC_ value is
# inlined by `next build` - and the demo and dev-demo Workers are deployed from
# one bundle, so an inlined value could only ever be right for one of them.
#
# Unset is fine: the badge falls back to https://honeystick.co.za.
HS_APP_URL=http://localhost:8081

# Where the store is reachable, used to build the payment provider's return and
# cancel URLs. Defaults to http://localhost:3000. Set this to the address you
# actually load - a LAN IP if you are testing on a phone - or the provider will
# send the shopper back to a host that is not serving anything.
NEXT_PUBLIC_STORE_URL=http://localhost:3000

# Extra hosts allowed to load the dev server cross-origin, comma-separated.
# next.config.ts already allows localhost and the 192.168.68.* subnet; add
# anything outside that here. Without it the page renders but every button is
# inert, because the client runtime never boots. Dev only.
NEXT_DEV_ORIGINS=
