# Honeystick Example App API - environment
#
# Copy to .env and fill in. Every .env file in this repo is gitignored; this
# template is not, so never put a real key here.
#
#   cp .env.example .env
#
# Everything below is read on the server only. Nothing here is ever sent to the
# Expo app: the whole point of the /billing mount is that the app holds no
# credential and reaches Honeystick through this server.

# Your Honeystick secret key, and the only thing needed to go live. It is a
# token that already carries the claim of which organization it belongs to, so
# there is no org id to set alongside it.
#
# This one variable is the switch between sample data and a live catalogue: with
# it unset the API serves DUMMY_PLANS from src/catalogue/plans.ts, /billing
# answers reads from the fixtures, and both checkout and subscribe stop short of
# the one call that needs an organization - so a fresh clone runs end to end.
HONEYSTICK_SECRET_KEY=

# Which Honeystick estate to call: `production` (default) or `dev`.
#
# The second of two axes, and the one nobody outside Honeystick sets. Four API
# servers run at once - a sandbox and a live on each of the two deployments -
# and between them your key and this variable pick exactly one:
#
#                     sandbox                            live
#   production        sandbox.honeystick.co.za           live.honeystick.co.za
#   dev               dev-sandbox.honeystick.co.za       dev-live.honeystick.co.za
#
# The row comes from here; the column comes from the key, which names its own
# environment (hs_sk_sandbox_... / hs_sk_live_...). Leave this unset and you get
# the production row, which is the only one a customer key works against.
HONEYSTICK_DEPLOYMENT=

# The signing secret for a webhook endpoint you registered.
#
# Distinct from the secret key above, and not interchangeable with it: this one
# is minted per endpoint (`whsec_...`), is shown in Settings → Integrations →
# Webhooks, and is only ever used to verify an HMAC. It is never sent anywhere.
#
# Unset is supported. The webhook route answers 503 rather than accepting posts
# it cannot verify - a route that trusts an unsigned body because it happens to
# have no secret is worse than no route at all.
#
# What arrives here is every event the endpoint subscribed to, signed and
# retried - as opposed to the per-checkout `notify_url` nudge, which carries
# only a settled payment and is neither.
HONEYSTICK_WEBHOOK_SECRET=


# Which Honeystick API to call, named outright.
#
# Only for an API that is not one of the four above - a local server, or a self
# hosted one. It wins over both the key's environment and HONEYSTICK_DEPLOYMENT,
# so setting it means neither is consulted.
#
# An origin only; the SDK appends /api/v1.
#
# The symptom of getting this wrong is a bare "fetch failed" and a silent fall
# back to the sample catalogue.
HONEYSTICK_URL=http://localhost:8787

# Where this API listens. The Expo app reaches it via EXPO_PUBLIC_API_URL, set
# in apps/expo-store/.env.local.
PORT=4000

# Where the payment provider sends a shopper after paying for a BASKET.
#
# Baskets only. Subscriptions no longer use this: they return to this API's own
# /return page, which hops to the app's URL scheme (demostore:// or
# depotstore://) and closes the browser. That page exists because PayFast is
# handed an http(s) return url and will not accept a custom scheme, and because
# a system browser has to be told to close by something inside it.
#
# Optional: defaults to http://localhost:3000.
STORE_URL=http://localhost:3000

# There is deliberately no variable for the payment-notification callback.
#
# Where Honeystick posts back to is derived from the request that reached this
# server - see notifyUrlFrom() in src/honeystick.ts - so the secret key above is
# the only thing anyone has to set. Whatever host reached this server resolves to
# it, including a tunnel's, which is exactly what a fixed value gets wrong.
#
# The consequence worth knowing: Honeystick calls that address from the internet,
# so a derived http://localhost:4000/... is reachable only by this machine. Run
# the API behind a tunnel and point the app at the tunnel URL, and the derivation
# produces the right address on its own. See docs/payment-notifications.md.
