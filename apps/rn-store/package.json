{
  "name": "@honeystick/rn-store",
  "version": "0.80.1",
  "private": true,
  "description": "Honeystick Example App on bare React Native - the same store, on @honeystick/react-native, with no Expo anywhere",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "pods": "cd ios && bundle install && bundle exec pod install",
    "lint": "eslint ."
  },
  "dependencies": {
    "@honeystick/react-native": "*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.3.13",
    "@tanstack/react-query": "^5.85.6",
    "honeystick": "*",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-fast-sse": "^0.3.2",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/react": "^19.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
