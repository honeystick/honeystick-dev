{
  "name": "honeystick",
  "version": "0.1.0",
  "description": "Honeystick billing client for JavaScript and TypeScript",
  "license": "MIT",
  "keywords": [
    "honeystick",
    "billing",
    "payments",
    "subscriptions",
    "usage-based",
    "metering",
    "payfast",
    "sdk"
  ],
  "homepage": "https://honeystick.co.za",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honeystick/honeystick-js.git",
    "directory": "packages/js"
  },
  "bugs": {
    "url": "https://github.com/honeystick/honeystick-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "tsc --build"
  },
  "sideEffects": false
}
