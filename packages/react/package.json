{
  "name": "@honeystick/react",
  "version": "0.1.0",
  "description": "Honeystick provider and hooks for React",
  "license": "MIT",
  "keywords": [
    "honeystick",
    "billing",
    "subscriptions",
    "usage-based",
    "metering",
    "react",
    "hooks",
    "sdk"
  ],
  "homepage": "https://honeystick.co.za",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honeystick/honeystick-js.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/honeystick/honeystick-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "tsc --build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.6",
    "honeystick": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
